properties:
  output_base_dir: "/root/backup/data/${CURRENT_DATE}"

tasks:
  - type: pack
    task_name: dokuwiki
    output_dir: "${output_base_dir}/dokuwiki"
    tar_run_dir: "/var/www"
    backup_list:
      - "dokuwiki/conf"
      - "dokuwiki/data/attic"
      - "dokuwiki/data/meta"
      - "dokuwiki/data/pages"
      - "dokuwiki/data/media"
      - "dokuwiki/data/media_attic"
      - "dokuwiki/data/media_meta"
    uploaders:
      - uploader_name: oss_uploader
        remote_dir: "${CURRENT_DATE}/dokuwiki"
      - uploader_name: ftp_uploader
        remote_dir: "${CURRENT_DATE}/dokuwiki"
  
  - type: mysql
    task_name: db1
    output_dir: "${output_base_dir}/mydb"
    dump_option:
      - "--user=root"
      - "--databases"
      - "mydb"
  
  - type: single_file
    task_name: file1
    output_dir: "${output_base_dir}/myfile"
    source_file: "/etc/profile"
    backup_on_change: false

uploaders:
  - type: oss
    name: oss_uploader
    access_id: "${ENV:OSS_ACCESS_KEY_ID}"
    access_key: "${ENV:OSS_ACCESS_KEY_SECRET}"
    endpoint: "endpoint"
    bucket_name: "bucket_name"
    # true: 临时对象上传并服务端复制，最终对象不会暴露未完成内容（默认）
    # false: 直接上传最终对象，仅产生一次上传，可能降低部分 OSS 的请求/存储费用
    use_temp_object: true
  
  - type: ftp
    name: ftp_uploader
    host: "host"
    port: 21
    username: "username"
    password: "${ENV:BACKUP_FTP_PASSWORD}"
    secure: false
    passive: true

